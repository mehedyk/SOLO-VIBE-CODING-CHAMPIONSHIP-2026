# ── Database (MongoDB Atlas, free M0 cluster) ─────────────────────────────
# Paste the connection string from Atlas > Connect > Drivers. Replace <password>.
MONGODB_URI=
MONGODB_DB=primary_visual_lab

# ── Optional ──────────────────────────────────────────────────────────────
# One-click judge accounts (no passwords) on the login page. Leave unset in real use.
# ENABLE_DEMO_ACCOUNTS=true
# Only for throw-away demos: lets production run without MongoDB (data is lost between requests on Vercel).
# ALLOW_MEMORY_DB=true
